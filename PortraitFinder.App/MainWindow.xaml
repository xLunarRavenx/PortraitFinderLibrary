                        </Expander.Header>

                        <StackPanel Orientation="Vertical">
                            <ItemsControl ItemsSource="{Binding Filters.Surrounding.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Name="PlayerClassExpander" IsExpanded="False">
                        <Expander.Header>
