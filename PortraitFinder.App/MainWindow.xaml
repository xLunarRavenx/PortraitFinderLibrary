                                    DockPanel.Dock="Right"
                                    Margin="10,0,0,0"
                                    CheckedText="All"
                                    UncheckedText="Any"
                                    IsChecked="{Binding Filters.Race.RequireAll}"
                                />
                            </DockPanel>
                        </Expander.Header>

                        <StackPanel Orientation="Vertical">
                            <ItemsControl ItemsSource="{Binding Filters.Race.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Name="HairColorExpander" IsExpanded="False">
