                                <controls:LabeledToggleSwitch
                                    DockPanel.Dock="Right"
                                    Margin="10,0,0,0"
                                    CheckedText="All"
                                    UncheckedText="Any"
                                    IsChecked="{Binding Filters.MythicPath.RequireAll}"
                                />
                            </DockPanel>
                        </Expander.Header>

                        <StackPanel Orientation="Vertical">
                            <ItemsControl ItemsSource="{Binding Filters.MythicPath.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected}" />
