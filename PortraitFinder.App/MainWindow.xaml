                                />
                            </DockPanel>
                        </Expander.Header>

                        <StackPanel Orientation="Vertical">
                            <ItemsControl ItemsSource="{Binding Filters.PlayerClass.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Name}"
