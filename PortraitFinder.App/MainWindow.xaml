<Window x:Class="PortraitFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PortraitFinder.App"
        xmlns:model="clr-namespace:PortraitFinder.App.ViewModels"
        xmlns:controls="clr-namespace:PortraitFinder.App.UserControls"
        mc:Ignorable="d"
        Title="Portrait Finder"
        Width="1700"
        Height="900"
        SizeChanged="Window_SizeChanged"
>
    <Window.Resources>
        <Style x:Key="ThumbnailToggleStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter TargetName="Border" Property="Background" Value="#081A2A"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#22598A"/>
                                <Setter TargetName="Border" Property="Background" Value="#102E4A"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>

                                <Setter TargetName="Border" Property="Background" Value="#163C60"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4EA3FF"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </MultiTrigger>                            
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="true">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DockPanel.Dock="Bottom" Margin="0,0,0,15">
                <Button x:Name="ResetFiltersButton" Content="Reset Filters" Click="ResetFiltersButton_Click" Width="100" HorizontalAlignment="Right" Focusable="False"/>
            </Grid>
            <ScrollViewer Name="ScrollViewerFilters" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10,10,0,15" Focusable="False">
                <StackPanel Orientation="Vertical" Focusable="False">
                    <!--
                    TODO:
                        * only display details tags when there are any
                        *    how to handle multiple portraits selected with differing tags?
                        * new window for EDITING selected portrait(s) tags
                    -->
                    <TextBlock Text="Filters" FontWeight="Bold" FontSize="16" Margin="10,5,0,5"/>
                    <Expander Name="GenderExpander" IsExpanded="False" Focusable="False">
                        <Expander.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock VerticalAlignment="Center" Text="Gender" />
                                <controls:LabeledToggleSwitch
                                    DockPanel.Dock="Right"
                                    Margin="10,0,0,0"
                                    CheckedText="All"
                                    UncheckedText="Any"
                                    IsChecked="{Binding Filters.Gender.RequireAll}"
                                />
                            </DockPanel>
                        </Expander.Header>

                        <StackPanel Orientation="Vertical">
                            <ItemsControl ItemsSource="{Binding Filters.Gender.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsSelected}"
                                            Focusable="False"
                                        />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Name="RaceExpander" IsExpanded="False">
