{
  "Serilog": {
    "Using": ["Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
        { 
            "Name": "File",
            "Args": {
                "pathIgnore": "%LOCALAPPDATA%/PortraitFinder/logs/log.txt",
                "path": "%LOCALAPPDATA%/PortraitFinder/logs/NEWlog.txt",
                "rollingInterval": "Infinite",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 104857600,
                "retainedFileCountLimit": 5,
                "shared": false,
                "outputTemplate": "{Timestamp}{NewLine}{Message}x{Newline}y",
                "outputTemplateOld": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{Newline}",
                "outputPatternIgnore": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{Newline}"
            }
        }
    ]
  }
}
